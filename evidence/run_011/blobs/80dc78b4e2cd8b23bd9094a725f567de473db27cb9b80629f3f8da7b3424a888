<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Antigense · Hardware defense with proof</title><style>
:root{color-scheme:dark;--bg:#101411;--panel:#19201a;--line:#354336;--text:#edf2e5;--muted:#a7b4a3;--green:#c4f280;--orange:#ffac65;--red:#ff6868}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui}header{display:flex;justify-content:space-between;padding:20px 5%;border-bottom:1px solid var(--line);align-items:center}.brand{font-size:23px;font-weight:800;letter-spacing:-1px}.tag{font:11px monospace;letter-spacing:2px;color:var(--green)}main{max-width:1480px;margin:auto;padding:35px 5%}h1{font-size:clamp(32px,4vw,58px);line-height:1.05;letter-spacing:-2px;margin:10px 0 18px;max-width:900px}h1 span{color:var(--green)}p{color:var(--muted)}.top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.pill{border:1px solid var(--line);border-radius:20px;padding:6px 12px;font:11px monospace;display:inline-block;color:var(--green)}.grid{display:grid;grid-template-columns:1.15fr 1fr;gap:20px}.card{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:22px;min-width:0}.label{font:11px monospace;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase}h2{font-size:22px;margin:8px 0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{padding:14px;border:1px solid var(--line);border-radius:12px}.num{font:24px monospace;color:var(--green)}.stage{display:flex;gap:12px;border-top:1px solid var(--line);padding:11px 4px;cursor:pointer}.stage:hover,.stage.active{background:#28362b;border-radius:9px}.dot{width:8px;height:8px;border-radius:50%;background:var(--muted);margin-top:7px;flex-shrink:0}.stage.active .dot{background:var(--orange);box-shadow:0 0 14px var(--orange)}.stage small{margin-left:auto;color:var(--muted);font:10px monospace;max-width:100px;text-align:right}.scene{height:330px;position:relative;overflow:hidden;border:1px solid #3d503d;border-radius:14px;margin:18px 0;background:radial-gradient(ellipse at center,#304832,#131b16)}.board{position:absolute;width:350px;height:260px;left:50%;top:44%;transform:translate(-50%,-50%) rotateX(47deg) rotateZ(-27deg);transform-style:preserve-3d;background:repeating-linear-gradient(0deg,transparent,transparent 26px,#39533b 27px),repeating-linear-gradient(90deg,#203828,#203828 26px,#39533b 27px);box-shadow:0 15px 0 #152218,0 30px 50px #050b06;border:3px solid #719467;transition:transform 1s}.scene{perspective:800px}.chip{position:absolute;display:grid;place-items:center;transform:translateZ(18px);background:#465544;border:2px solid #9bb48b;box-shadow:10px 13px 0 #122416;font:bold 14px monospace}.chip.fault{background:#794332;border-color:var(--orange);box-shadow:10px 13px 0 #3e241c,0 0 50px #ff7d3450}.cpu{width:100px;height:90px;left:60px;top:40px}.memory{width:40px;height:145px;left:230px;top:25px}.gpu{width:165px;height:53px;left:75px;top:180px}.wire{position:absolute;width:100px;height:4px;background:var(--green);left:155px;top:97px}.fault .wire{background:var(--orange)}.overlay{position:absolute;left:14px;bottom:12px;color:var(--muted);font:10px monospace}.float{position:absolute;right:15px;top:15px;max-width:170px;background:#0c1511bb;border:1px solid var(--line);border-radius:10px;padding:10px;font:11px monospace}.float strong{color:var(--orange)}.row{display:flex;gap:9px;flex-wrap:wrap;margin:15px 0}button,a.button{background:var(--green);border:0;border-radius:9px;padding:11px 15px;font-weight:700;color:#192315;text-decoration:none;cursor:pointer}button.secondary{background:transparent;color:var(--text);border:1px solid var(--line)}button:disabled{opacity:.4;cursor:default}.sponsors{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}.sponsor h3{margin:6px 0;font-size:23px}.sponsor p{font-size:13px;margin:5px 0}.status{color:var(--orange);font:11px monospace}.proof{margin-top:20px;display:grid;grid-template-columns:1fr 1fr;gap:20px}code{font:11px/1.8 monospace;overflow-wrap:anywhere}.proof h3{margin:7px 0}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:11px/1.6 monospace;background:#111913;border-radius:10px;padding:14px;max-height:360px;overflow:auto}.good{color:var(--green)}.bad{color:var(--red)}footer{padding:25px 0;color:var(--muted);font-size:11px}a{color:var(--green)}.warning{font-size:12px;color:var(--orange)}@media(max-width:850px){.grid,.proof{grid-template-columns:1fr}.top{display:block}.sponsors{grid-template-columns:1fr}.card{padding:16px}main{padding:25px 4%}.scene{height:300px}.board{scale:.85}.stats .num{font-size:18px}header{padding:14px}.tag{letter-spacing:0}}
</style></head><body><header><div class="brand">antigense<span style="color:var(--green)">.</span></div><div class="tag">AGENTIC INTELLIGENCE / CONTINUOUS DEFENSE</div></header><main><div class="top"><div><div class="label">Hardware → software → security</div><h1>One corrupt signal.<br><span>A defense you can verify.</span></h1><p>See the error, inspect the attack path, review the fix, recompute the proof.</p></div><div><span id="mode" class="pill">RECORDED REPLAY</span><p style="font-size:12px">Controlled software fault · no physical damage</p></div></div><div class="grid"><section class="card"><div class="label">Virtual hardware / custody map</div><h2 id="headline">Integrity before intelligence</h2><div class="scene"><div class="board" id="board"><div class="wire"></div><div class="chip cpu">CPU</div><div class="chip memory">RAM</div><div class="chip gpu" id="gpu">GPU / WORKER</div></div><div class="float"><div id="faultlabel">Baseline arithmetic</div><strong id="signal">332833500</strong><div id="source">Recorded worker result</div></div><div class="overlay">ILLUSTRATIVE 3D SCHEMATIC · geometry and GPU sensors unmeasured</div></div><div class="stats"><div class="stat"><div class="label">CPU count</div><div class="num" id="cpu">—</div></div><div class="stat"><div class="label">Memory</div><div class="num" id="mem">—</div></div><div class="stat"><div class="label">Load / 1 min</div><div class="num" id="load">—</div></div></div><p id="telemetry" style="font-size:11px">Public replay has no access to private live hardware. Temperature, ECC and power UNKNOWN.</p><div class="row"><button id="replay">Replay trace</button><button class="secondary" id="verify">Recompute proofs</button><button class="secondary" id="run" hidden>Run bounded scenario</button><button id="approve" hidden>Approve pinned fix</button></div><div id="notice" class="warning">Replay timings are presentation timings, not measurements.</div></section><section class="card"><div class="label">Executed trace / click to inspect</div><h2>The error stays in the loop.</h2><div id="stages"></div></section></div><div class="sponsors"><div class="card sponsor"><div class="label">01 / Find the flaw</div><h3>Semgrep</h3><p>Local source scan pinpoints the fail-open fallback. Before/after scans bind the exact target and rule hashes.</p><div id="semgrep" class="status">NOT_TESTED</div></div><div class="card sponsor"><div class="label">02 / Explain on GPU</div><h3>Akash</h3><p>Sanitized inference route prepared. Confidential GPU claim requires a verified lease and fresh CPU + GPU attestation.</p><div id="akash" class="status">NOT_TESTED · local AI is separate</div></div><div class="card sponsor"><div class="label">03 / Review the response</div><h3>Pi Security</h3><p>Reproduction, attack-path evidence and pinned fix form a review packet. A local approval gate remains explicit.</p><div class="status">NOT_TESTED · private/local option UNKNOWN</div></div></div><div class="proof"><section class="card"><div class="label">Calculated commitments</div><h3 id="verification">Verification pending</h3><p style="font-size:12px">Browser recomputes committed leaves and every MMR prefix. Python also checks classifications, delta-G* and source bytes.</p><div class="label">Frozen source graph / project ID</div><code id="root">NOT_COMPUTED</code><div class="label" style="margin-top:12px">Current MMR root</div><code id="mmr">NOT_COMPUTED</code><p id="leaves"></p><div class="row"><a href="data/proof.json">Download proof</a><a href="data/run.json">Execution record</a><a href="https://github.com/biobitworks/antigense-cyberhack">Submission repo</a></div></section><section class="card"><div class="label">Selected custody object</div><h3 id="selected">Select a checkpoint</h3><pre id="detail">Loading execution evidence…</pre></section></div><footer>Hashes establish byte integrity, not truth, safety or causality. Anticube identity/safety UNKNOWN; SELF_SAFE null. Delta-G* is an unvalidated information-state diagnostic. Sponsor executions appear only when observed. Name provisional.</footer></main><script src="verify.js"></script><script>
let current=null,selected=0,token=null,local=false,polling=false;
const $=id=>document.getElementById(id);function show(s){selected=s;const st=current?.stages[s];if(!st)return;document.querySelectorAll('.stage').forEach((e,i)=>e.classList.toggle('active',i===s));$('headline').textContent=st.name.slice(3);$('selected').textContent=st.name;$('detail').textContent=JSON.stringify(st,null,2);$('board').style.transform=`translate(-50%,-50%) rotateX(47deg) rotateZ(${-27+s*2}deg)`;$('gpu').classList.toggle('fault',s>=1&&s<8);$('board').classList.toggle('fault',s>=1&&s<8);$('faultlabel').textContent=s>=8?'Recovery verified':s>=1?'SIMULATED BYTE CORRUPTION':'Baseline arithmetic';$('signal').textContent=s>=8?'FAIL CLOSED':s>=1?'SHA-256 MISMATCH':'332833500';$('source').textContent='Recorded scenario observation'}
function draw(r){if(!r)return;current=r;$('root').textContent=r.project_root;$('mmr').textContent=r.mmr_root;$('leaves').textContent=`${r.leaf_count} MMR leaves · phase ${r.phase}`;$('semgrep').textContent=r.sponsors.Semgrep;$('akash').textContent=r.sponsors.Akash+' · GPU / TEE verification NOT_TESTED';$('stages').replaceChildren();r.stages.forEach((s,i)=>{let e=document.createElement('div');e.className='stage';let dot=document.createElement('span');dot.className='dot';let name=document.createElement('span');name.textContent=s.name;let state=document.createElement('small');state.textContent=s.state;e.append(dot,name,state);e.onclick=()=>show(i);$('stages').append(e)});$('approve').hidden=!local||r.phase!=='awaiting_review';show(Math.min(selected,r.stages.length-1))}
async function refresh(){try{draw(await (await fetch('data/run.json',{cache:'no-store'})).json())}catch(e){$('notice').textContent='Run a local scenario to create execution evidence.'}}
async function verify(){const e=$('verification');e.textContent='Recomputing SHA-256…';try{let p=await(await fetch('data/proof.json',{cache:'no-store'})).json();let pass=await verifyProof(p);e.textContent=pass?'Browser integrity PASS / YES':'Browser integrity FAIL / NO';e.className=pass?'good':'bad';e.dataset.pass=String(pass)}catch(x){e.textContent='Proof unavailable / NOT_TESTED';e.dataset.pass='false'}}
$('verify').onclick=verify;$('replay').onclick=()=>{let i=0;show(i);$('notice').textContent='RECORDED REPLAY · presentation clock';let t=setInterval(()=>{if(!current||++i>=current.stages.length){clearInterval(t);return}show(i)},4200)};
async function action(path,body){let res=await fetch(path,{method:'POST',headers:{'Content-Type':'application/json','X-Custody-Token':token},body:JSON.stringify(body)});$('notice').textContent=res.ok?'Local action accepted; receipts update as execution runs.':JSON.stringify(await res.json());if(res.ok){selected=99;setTimeout(refresh,1000)}}
$('run').onclick=()=>action('/api/run',{});$('approve').onclick=()=>action('/api/approve',{expected_mmr:current.mmr_root,provenance:'UNSIGNED_LOCAL_BROWSER_ACTION'});
(async()=>{await refresh();if(location.hostname==='127.0.0.1'&&location.port==='8790'){try{let s=await(await fetch('/api/session')).json();token=s.token;local=true;$('mode').textContent='LOCAL LIVE OS + RECORDED TRACE';$('run').hidden=false;draw(current);setInterval(async()=>{if(polling)return;polling=true;try{let s=await(await fetch('/api/snapshot')).json();$('cpu').textContent=s.cpu_count;$('mem').textContent=s.memory_bytes?(s.memory_bytes/2**30).toFixed(0)+' GiB':'UNKNOWN';$('load').textContent=s.load_average[0].toFixed(2);$('telemetry').textContent='LIVE OS poll '+new Date(s.observed_epoch_ms).toLocaleTimeString()+' · load is not CPU utilization · GPU sensors UNKNOWN';if(s.run&&(!current||s.run.mmr_root!==current.mmr_root||s.run.phase!==current.phase))draw(s.run)}finally{polling=false}},1000)}catch(e){}}await verify()})();
</script></body></html>